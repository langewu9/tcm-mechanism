generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  String                 @default("RESEARCHER")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  datasets              Dataset[]
  cases                 MedicalCase[]
  tasks                 AnalysisTask[]
  pathwayEnrichmentRuns PathwayEnrichmentRun[]
  proteomicsDatasets    ProteomicsDataset[]
  proteomicsAnalyses    ProteomicsAnalysis[]
}

model Dataset {
  id          String       @id @default(cuid())
  name        String
  description String?
  filename    String
  type        String
  rowCount    Int          @default(0)
  columnsJson String       @default("[]")
  createdAt   DateTime     @default(now())
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rows        DatasetRow[]
}

model DatasetRow {
  id        String  @id @default(cuid())
  index     Int
  dataJson  String
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model ProteomicsDataset {
  id          String               @id @default(cuid())
  name        String
  description String?
  filename    String
  type        String
  rowCount    Int                  @default(0)
  columnsJson String               @default("[]")
  mappingJson String               @default("{}")
  createdAt   DateTime             @default(now())
  ownerId     String
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rows        ProteomicsRow[]
  analyses    ProteomicsAnalysis[]

  @@index([ownerId, createdAt])
}

model ProteomicsRow {
  id             String            @id @default(cuid())
  index          Int
  originalLabel  String
  proteinName    String?
  geneSymbol     String?
  log2FoldChange Float?
  pValue         Float?
  fdr            Float?
  direction      String?
  dataJson       String
  datasetId      String
  dataset        ProteomicsDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, index])
  @@index([datasetId, geneSymbol])
}

model ProteomicsAnalysis {
  id                    String            @id @default(cuid())
  name                  String
  status                String            @default("COMPLETED")
  log2FcMin             Float             @default(1)
  fdrMax                Float             @default(0.05)
  pValueMax             Float             @default(0.05)
  inputRowCount         Int               @default(0)
  selectedRowCount      Int               @default(0)
  normalizedCount       Int               @default(0)
  unmappedCount         Int               @default(0)
  candidateOverlapCount Int               @default(0)
  sourceVersion         String?
  resultJson            String
  errorMessage          String?
  createdAt             DateTime          @default(now())
  finishedAt            DateTime?
  ownerId               String
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  datasetId             String
  dataset               ProteomicsDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([datasetId, createdAt])
}

model MedicalCase {
  id          String         @id @default(cuid())
  title       String
  patientInfo String?
  symptoms    String
  tonguePulse String?
  diagnosis   String?
  source      String?
  createdAt   DateTime       @default(now())
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tasks       AnalysisTask[]
}

model Syndrome {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  formulas    Formula[]
}

model Formula {
  id         String     @id @default(cuid())
  name       String     @unique
  indication String?
  syndromes  Syndrome[]
  herbs      Herb[]
}

model Herb {
  id        String     @id @default(cuid())
  name      String     @unique
  meridian  String?
  effect    String?
  formulas  Formula[]
  compounds Compound[]
}

model Compound {
  id        String   @id @default(cuid())
  name      String   @unique
  pubchemId String?
  herbs     Herb[]
  targets   Target[]
}

model Target {
  id        String     @id @default(cuid())
  symbol    String     @unique
  name      String?
  compounds Compound[]
  genes     Gene[]
  pathways  Pathway[]
}

model Gene {
  id           String    @id @default(cuid())
  symbol       String    @unique
  name         String?
  source       String    @default("LOCAL")
  externalId   String?
  sourceUrl    String?
  lastSyncedAt DateTime?
  targets      Target[]
}

model Pathway {
  id              String                  @id @default(cuid())
  name            String                  @unique
  description     String?
  source          String                  @default("LOCAL")
  externalId      String?                 @unique
  species         String?
  sourceUrl       String?
  lastSyncedAt    DateTime?
  targets         Target[]
  enrichmentItems PathwayEnrichmentItem[]
}

model PathwayEnrichmentRun {
  id                  String                  @id @default(cuid())
  herb                String
  disease             String
  source              String                  @default("REACTOME")
  sourceVersion       String?
  sourceToken         String?
  inputCount          Int
  rawTargetCount      Int                     @default(0)
  identifiersFound    Int
  identifiersNotFound Int
  createdAt           DateTime                @default(now())
  ownerId             String
  owner               User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items               PathwayEnrichmentItem[]

  @@index([ownerId, createdAt])
}

model PathwayEnrichmentItem {
  id              String               @id @default(cuid())
  rank            Int
  matchedEntities Int
  totalEntities   Int
  coverage        Float
  pValue          Float
  fdr             Float
  runId           String
  run             PathwayEnrichmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  pathwayId       String
  pathway         Pathway              @relation(fields: [pathwayId], references: [id], onDelete: Cascade)

  @@unique([runId, pathwayId])
  @@index([pathwayId])
}

model AnalysisTask {
  id          String          @id @default(cuid())
  name        String
  status      String          @default("COMPLETED")
  query       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  caseId      String?
  medicalCase MedicalCase?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  result      AnalysisResult?
}

model AnalysisResult {
  id           String       @id @default(cuid())
  summary      String
  evidenceJson String
  networkJson  String
  createdAt    DateTime     @default(now())
  taskId       String       @unique
  task         AnalysisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model DatabaseSource {
  id                  String            @id @default(cuid())
  name                String            @unique
  driver              String            @default("SQLITE")
  connectionUrl       String?
  environmentVariable String?
  mappingJson         String
  enabled             Boolean           @default(true)
  syncCursor          Int               @default(0)
  lastConnectedAt     DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  syncRuns            DatabaseSyncRun[]
}

model DatabaseSyncRun {
  id              String         @id @default(cuid())
  sourceId        String
  source          DatabaseSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status          String         @default("RUNNING")
  rowsRead        Int            @default(0)
  herbsSynced     Int            @default(0)
  compoundsSynced Int            @default(0)
  targetsSynced   Int            @default(0)
  errorMessage    String?
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?

  @@index([sourceId, startedAt])
}
