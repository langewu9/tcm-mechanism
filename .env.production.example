# Copy to .env.production and replace every example value. Never commit .env.production.
PUBLIC_DOMAIN=research.example.org
PUBLIC_BASE_URL=https://research.example.org
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-64-hex-characters
REDIS_PASSWORD=replace-with-64-hex-characters
R_VIZ_API_TOKEN=replace-with-a-long-random-token

# Researcher account registration uses SMTP email verification before administrator approval.
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=research-platform@example.org
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=research-platform@example.org
ADMIN_NOTIFICATION_EMAILS=platform-admin@example.org
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400

# Use a private bucket on an S3-compatible service. The app streams private files
# through Django after checking the signed-in user's permissions.
S3_ENDPOINT_URL=https://s3.example.org
S3_BUCKET_NAME=tcm-platform-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

DATASET_UPLOAD_MAX_BYTES=104857600
# Optional STRING version pin; blank auto-discovers the current version per analysis.
STRING_DB_VERSION=

# Optional private/local model endpoint for the case-analysis worker. Configure only after
# deploying the model on the same host/private network and setting its real release version.
CASE_MODEL_BASE_URL=
CASE_MODEL_NAME=
CASE_MODEL_VERSION=configure-the-installed-model-version
CASE_MODEL_API_KEY=
CASE_MODEL_TIMEOUT_SECONDS=180
CASE_ANALYSIS_MAX_INPUT_CHARS=20000
DJANGO_LOGIN_IP_RATE=30/min
DJANGO_LOGIN_ACCOUNT_RATE=10/min
SOURCE_SCHEDULED_PREVIEWS_ENABLED=false
