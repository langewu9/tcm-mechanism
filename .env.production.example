# Copy to .env.production and replace every example value. Never commit .env.production.
PUBLIC_DOMAIN=research.example.org
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-64-hex-characters
REDIS_PASSWORD=replace-with-64-hex-characters
R_VIZ_API_TOKEN=replace-with-a-long-random-token

# Use a private bucket on an S3-compatible service. The app streams private files
# through Django after checking the signed-in user's permissions.
S3_ENDPOINT_URL=https://s3.example.org
S3_BUCKET_NAME=tcm-platform-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path

DATASET_UPLOAD_MAX_BYTES=104857600
# Optional STRING version pin; blank auto-discovers the current version per analysis.
STRING_DB_VERSION=
