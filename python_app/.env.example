DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgresql://tcm_platform:tcm_platform_dev_only@127.0.0.1:5432/tcm_platform
# Optional separate SQLite corpus URL; Compose sets its container path automatically.
# Omit for host-run development to use python_app/var/case-rag/corpus.sqlite3.
# CASE_RAG_DATABASE_URL=sqlite:////app/var/case-rag/corpus.sqlite3
MEDIA_ROOT=var/media
# In development verification messages are printed to the Django console.
PUBLIC_BASE_URL=http://127.0.0.1:5173
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400
DATASET_UPLOAD_MAX_BYTES=104857600
PROTEOMICS_MAX_ROWS=25000
PROTEOMICS_MAX_COLUMNS=250
PROTEOMICS_MAX_CELLS=1000000
SQLITE_SOURCE_ROOT=/path/to/approved/source-databases
SQLITE_SOURCE_MAX_BYTES=536870912
SQLITE_SOURCE_MAX_ROWS=500000
# Optional exact version override; blank auto-discovers then pins the current version.
STRING_DB_VERSION=
# Optional, trusted local/private OpenAI-compatible model used only after each case-analysis confirmation.
# Docker Compose worker → model on host: use host.docker.internal; host-run worker → host model: use 127.0.0.1.
CASE_MODEL_BASE_URL=http://host.docker.internal:8000/v1
CASE_MODEL_NAME=QLUNLP/BianCang-Qwen2.5-7B-Instruct
CASE_MODEL_VERSION=configure-the-installed-model-version
CASE_MODEL_API_KEY=
CASE_MODEL_TIMEOUT_SECONDS=180
CASE_ANALYSIS_MAX_INPUT_CHARS=20000
R_VIZ_BASE_URL=http://127.0.0.1:8001
R_VIZ_API_TOKEN=replace-with-a-random-secret
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
DJANGO_LOGIN_IP_RATE=30/min
DJANGO_LOGIN_ACCOUNT_RATE=10/min
# Opt-in: schedule previews only; applying a release still requires administrator approval.
SOURCE_SCHEDULED_PREVIEWS_ENABLED=false
