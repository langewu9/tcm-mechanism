FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY python_app/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --home-dir /app --no-create-home app \
    && mkdir -p /app/var/media /app/var/celery /app/var/runtime-logs /app/var/case-rag /app/staticfiles \
    && chmod 700 /app/var/runtime-logs \
    && chown -R app:app /app
COPY --chown=app:app python_app/ /app/
USER app

EXPOSE 8020
