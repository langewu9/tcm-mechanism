server {
    listen 80 default_server;
    server_name _;
    access_log /var/log/nginx/access.log platform_safe;
    location = /healthz { access_log off; return 204; }
    location / { return 444; }
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    access_log /var/log/nginx/access.log platform_safe;
}

server {
    listen 80;
    server_name ${PUBLIC_DOMAIN};
    access_log /var/log/nginx/access.log platform_safe;

    location = /healthz {
        access_log off;
        return 204;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_DOMAIN};
    access_log /var/log/nginx/access.log platform_safe;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 1m;
    client_body_timeout 30s;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml;
    include /etc/nginx/snippets/security-headers.conf;

    error_page 413 = @request_too_large;
    error_page 502 504 = @api_unavailable;
    limit_req_status 429;
    error_page 429 = @registration_rate_limited;

    location @request_too_large {
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "private, no-store" always;
        add_header X-Request-ID $request_id always;
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"请求内容超过允许大小。","details":null,"requestId":"$request_id"}}';
    }

    location @api_unavailable {
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "private, no-store" always;
        add_header X-Request-ID $request_id always;
        return 503 '{"error":{"code":"SERVICE_UNAVAILABLE","message":"平台服务暂不可用，请稍后重试。","details":null,"requestId":"$request_id"}}';
    }

    location = /api/v1/research/datasets/ {
        client_max_body_size 110m;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
    }

    location = /index.html {
        root /usr/share/nginx/html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control no-cache always;
    }

    location ~ ^/(media|uploads)/ { return 404; }

    location /static/ {
        alias /srv/django-static/;
        access_log off;
        expires 7d;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /api/v1/auth/session/ {
        limit_req zone=researcher_login burst=5 nodelay;
        limit_req_status 429;
        error_page 429 = @registration_rate_limited;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location = /api/v1/auth/register/ {
        limit_req zone=researcher_registration burst=2 nodelay;
        limit_req_status 429;
        error_page 429 = @registration_rate_limited;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location @registration_rate_limited {
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header X-Request-ID $request_id always;
        add_header Cache-Control "private, no-store" always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"请求过于频繁，请稍后重试。","details":null,"requestId":"$request_id"}}';
    }

    location ~ ^/(accounts|django-admin)/login/$ {
        limit_req zone=researcher_login burst=5 nodelay;
        limit_req_status 429;
        error_page 429 = @registration_rate_limited;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /accounts/ {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /django-admin/ {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
